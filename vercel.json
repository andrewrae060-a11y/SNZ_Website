{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__apiPath=sitemap.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__apiPath=:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
