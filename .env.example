# Cloudflare Turnstile protects the Content Manager and Careers admin logins.
# Create a Turnstile widget in Cloudflare and restrict it to the deployed hostnames.
# Local development uses Cloudflare's official test keys when these are omitted.
# The production site key is also embedded in the frontend as a safe public value.
VITE_TURNSTILE_SITE_KEY=your_public_turnstile_site_key
TURNSTILE_SECRET=your_private_turnstile_secret_key
TURNSTILE_HOSTNAMES=www.smartnetzero.co.uk,smartnetzero.co.uk
